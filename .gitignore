.claude/
.DS_Store
__pycache__/
~$*.xlsx
data/twtsl/raw_details.jsonl
data/refs/tslcorpus_raw.jsonl
# 訓練切分：jsonl 可由 split_data.py 再生，不入庫；僅保留 manifest 供追溯
data/splits/*.jsonl
# 訓練產出與環境（VM 端，不入庫）
.venv/
outputs/
*.log

# 評估詞彙表（可由 build_eval_vocab.py 再生；依賴 splits）
data/vocab/eval_vocab.json

# HF model repo 的權重與訓練狀態：本機備妥供上傳 Hugging Face（走 HF LFS），不進本 git repo。
# checkpoint-* 為訓練產出的完整快照（含權重＋optimizer 等），整包不入庫；
# 只保留 model card（models/tsl-gloss-e4b-v4-lora/README.md）追蹤。
models/**/checkpoint-*/
models/**/*.safetensors
models/**/*.bin
models/**/*.pt
models/**/*.pth
data/splits_json/*.jsonl
data/moe/

# 影片庫覆蓋率評估用的鏡像檔：0813 recordings/ 的副本，屬非公開訓練素材，
# 用 scp 從學校主機再抓即可（見 scripts/eval_video_coverage.py docstring）
data/video/lexicon.json
data/video/moe_dict_words.json

# 腳本格式訓練資料：可由 build_script_dataset.py 從 splits＋sign_inventory 再生（16MB），
# 不入庫；涵蓋率統計 coverage_stats.json 是評估結論，要留。
data/splits_script/*.jsonl

# 台灣手語教材（tslcopus.deaf.com.tw）：站上無版權宣告、授權未查證。
# 比照 data/moe/ 保守處理——可本機／VM 用於評估，不推上公開 repo，
# 論文附錄不附原始句對。要公開請先去信 tsl@deaf.com.tw。
data/tsl_textbook/

.claude/
.DS_Store
__pycache__/
~$*.xlsx
data/twtsl/raw_details.jsonl
data/refs/tslcorpus_raw.jsonl
# 訓練切分：jsonl 可由 split_data.py 再生，不入庫；僅保留 manifest 供追溯
data/splits/*.jsonl
# 訓練產出與環境（VM 端，不入庫）
.venv/
outputs/
*.log

# 評估詞彙表（可由 build_eval_vocab.py 再生；依賴 splits）
data/vocab/eval_vocab.json

# HF model repo 的權重與訓練狀態：本機備妥供上傳 Hugging Face（走 HF LFS），不進本 git repo。
# checkpoint-* 為訓練產出的完整快照（含權重＋optimizer 等），整包不入庫；
# 只保留 model card（models/tsl-gloss-e4b-v4-lora/README.md）追蹤。
models/**/checkpoint-*/
models/**/*.safetensors
models/**/*.bin
models/**/*.pt
models/**/*.pth
data/splits_json/*.jsonl
data/moe/

# 影片庫覆蓋率評估用的鏡像檔：0813 recordings/ 的副本，屬非公開訓練素材，
# 用 scp 從學校主機再抓即可（見 scripts/eval_video_coverage.py docstring）
data/video/lexicon.json
data/video/moe_dict_words.json

# 腳本格式訓練資料：可由 build_script_dataset.py 從 splits＋sign_inventory 再生（16MB），
# 不入庫；涵蓋率統計 coverage_stats.json 是評估結論，要留。
data/splits_script/*.jsonl

# 台灣手語教材（tslcopus.deaf.com.tw）：站上無版權宣告、授權未查證。
# 比照 data/moe/ 保守處理——可本機／VM 用於評估，不推上公開 repo，
# 論文附錄不附原始句對。要公開請先去信 tsl@deaf.com.tw。
data/tsl_textbook/
data/splits_script_k60/*.jsonl
.venv-emb/
data/signs/gloss_emb_bge_small_zh.npz
data/signs/semantic_query_cache.json

# IG @tslsigner 的補片素材：第三方影片，已取得作者授權供本專案使用，但不散布，
# 不入庫。要重抓見 scripts/match_ig_tslsigner.py --download。
data/video/ig_tslsigner_clips/

# v17／v17cd 當時的凍結切分（data/splits_v17/）**要入庫**，它是歷史數字的對帳
# 錨點，讓乾淨 clone 也能跑 tests/test_eval_script_format.py（審查意見 5.2）。
# 唯一例外是教材集：比照上面 data/tsl_textbook/ 的保守處理，授權未查證，不公開。
data/splits_v17/test_textbook.jsonl

# 影片品質掃描表：0813 quality_scan/entries_final.csv 的鏡像，與 lexicon.json
# 同屬非公開訓練素材，比照處理。掃描結果的**結論**（asset_class／quality_tier）
# 已寫進受版控的 data/signs/sign_inventory.jsonl，下游不需要這份原始檔；
# 只有重建總表時要，取得方式見 scripts/data_preflight.py 的提示。
data/video/entries_final.csv

# 來源雜湊快照：由 scripts/data_preflight.py --write-manifest 產生。
# 目前不入庫——本分支的 data/tslcorpus/parallel.jsonl 還在人工校訂中，
# 先鎖 hash 會變成對他人在製品的絆索。校訂落地後再產一份 commit 進來。
data/source_manifest.json
